    "express": "^4.21.2",
    "express-fileupload": "^1.5.1",
    "gravatar": "^1.8.0",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.17.0",
    "mongoose": "^8.17.0",
    "multer": "^1.4.2",
